# Only array-processing modules and the EdgeDrawing-only contrib module.
set(BUILD_LIST "core,imgproc,flann,features2d,calib3d,ximgproc,python3" CACHE STRING "" FORCE)
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_ZLIB ON CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_PERF_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_apps OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_java OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_python2 OFF CACHE BOOL "" FORCE)
set(BUILD_opencv_python3 ON CACHE BOOL "" FORCE)
set(OPENCV_SKIP_PYTHON_LOADER ON CACHE BOOL "" FORCE)
set(OPENCV_PYTHON3_VERSION "" CACHE STRING "" FORCE)
set(OPENCV_PYTHON3_INSTALL_PATH "unused" CACHE PATH "" FORCE)
set(OPENCV_DISABLE_FILESYSTEM_SUPPORT ON CACHE BOOL "" FORCE)
set(PARALLEL_ENABLE_PLUGINS OFF CACHE BOOL "" FORCE)
set(HIGHGUI_ENABLE_PLUGINS OFF CACHE BOOL "" FORCE)
set(VIDEOIO_ENABLE_PLUGINS OFF CACHE BOOL "" FORCE)
set(ENABLE_BUILD_HARDENING ON CACHE BOOL "" FORCE)
set(ENABLE_PRECOMPILED_HEADERS OFF CACHE BOOL "" FORCE)
foreach(feature JPEG PNG TIFF WEBP OPENJPEG JASPER OPENEXR JPEGXL AVIF SPNG
                FFMPEG GSTREAMER MSMF DSHOW AVFOUNDATION V4L GDAL GDCM
                GTK QT WIN32UI COCOA OPENGL OPENCL CUDA CUDNN IPP ITT
                TBB OPENMP LAPACK EIGEN CAROTENE FASTCV PROTOBUF KLEIDICV
                VTK FLATBUFFERS OPENVX VA VA_INTEL DIRECTX
                IMGCODEC_GIF IMGCODEC_HDR IMGCODEC_SUNRASTER IMGCODEC_PXM IMGCODEC_PFM)
  set(WITH_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(codec JPEG PNG TIFF WEBP OPENJPEG OPENEXR JPEGXL AVIF SPNG)
  set(BUILD_${codec} OFF CACHE BOOL "" FORCE)
endforeach()
